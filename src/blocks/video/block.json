{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "html5-player/video",
  "title": "HTML5 Video Player",
  "version": "2.9.1",
  "description": "Embed Video anywhere in your website ",
  "category": "media",
  "icon": "video-alt2",
  "keywords": [
    "HTML5 Video Player",
    "Media Player",
    "Video"
  ],
  "textdomain": "html5-video-player",
  "attributes": {
    "provider": {
      "type": "string",
      "default": "self-hosted"
    },
    "presetId": {
      "type": [
        "string",
        "number"
      ],
      "default": null
    },
    "imported": {
      "type": "boolean",
      "default": false
    },
    "clientId": {
      "type": "string"
    },
    "skin": {
      "type": "string",
      "default": "default"
    },
    "uniqueId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": ""
    },
    "poster": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "array",
      "default": []
    },
    "options": {
      "type": "object",
      "default": {
        "controls": [
          "play-large",
          "play",
          "progress",
          "current-time",
          "mute",
          "volume",
          "captions",
          "settings",
          "airplay",
          "fullscreen"
        ],
        "settings": [
          "captions",
          "quality",
          "speed",
          "loop"
        ],
        "loadSprite": true,
        "autoplay": false,
        "playsinline": true,
        "seekTime": 10,
        "volume": 1,
        "muted": false,
        "hideControls": true,
        "resetOnEnd": false,
        "tooltips": {
          "controls": true,
          "seek": true
        },
        "captions": {
          "active": true,
          "language": "auto",
          "update": true
        },
        "ratio": null,
        "storage": {
          "enabled": true,
          "key": "plyr"
        },
        "speed": {
          "options": [
            0.5,
            0.75,
            1,
            1.25,
            1.5,
            1.75,
            2
          ]
        },
        "loop": {
          "active": false
        },
        "ads": {
          "enabled": true,
          "tagUrl": null
        },
        "urls": {
          "enabled": false,
          "download": null
        },
        "markers": {
          "enabled": false,
          "points": []
        },
        "preload": "metadata"
      }
    },
    "styles": {
      "type": "object",
      "default": {
        "plyr_wrapper": {
          "width": "100%",
          "borderRadius": "0px",
          "overflow": "hidden"
        }
      }
    },
    "ratio": {
      "type": "string",
      "default": null
    },
    "controls": {
      "type": "object",
      "default": {
        "play-large": true,
        "restart": false,
        "rewind": false,
        "play": true,
        "fast-forward": false,
        "progress": true,
        "current-time": true,
        "duration": false,
        "mute": true,
        "volume": true,
        "pip": false,
        "airplay": false,
        "settings": true,
        "downlaod": false,
        "fullscreen": true
      }
    },
    "brandColor": {
      "type": "string",
      "default": "#00B3FF"
    },
    "width": {
      "type": "object",
      "default": {
        "deprecated": true,
        "number": 100,
        "unit": "%"
      }
    },
    "radius": {
      "type": "object",
      "default": {
        "number": 0,
        "unit": "px"
      }
    },
    "repeat": {
      "type": "boolean",
      "default": false
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "muted": {
      "type": "boolean",
      "default": false
    },
    "playsinline": {
      "type": "boolean",
      "default": false
    },
    "resetOnEnd": {
      "type": "boolean",
      "default": false
    },
    "autoHideControl": {
      "type": "boolean",
      "default": true
    },
    "preload": {
      "type": "string",
      "default": "metadata"
    }
  },
  "supports": {
    "html": false,
    "lock": false,
    "reusable": false,
    "align": [
      "left",
      "center",
      "right"
    ]
  },
  "example": {
    "attributes": {
      "preview": true
    }
  },
  "viewStyle": [
    "h5vp-plyr",
    "h5vp-view"
  ],
  "editorStyle": [
    "h5vp-blocks",
    "h5vp-plyr"
  ],
  "editorScript": [
    "h5vp-blocks",
    "h5vp-plyr",
    "wp-util",
    "wp-data",
    "wp-block-editor"
  ],
  "render": "file:./../render.php",
  "viewScript": [
    "h5vp-view"
  ]
}